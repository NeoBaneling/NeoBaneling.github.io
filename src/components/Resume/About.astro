---
import { Image } from 'astro:assets';
import Timeline from '../Timeline';
import headshot from '../../assets/headshot.png';
---

<section id="about" class="section px-4.5 pt-24 md:px-12 md:pt-42">
	<h2 class="title mb-24 ml-7.5 md:ml-0">About 🦘</h2>
	<div class="col-group space-y-9 md:space-y-0">
		<div class="col-item md:space-y-12">
			<Image src={headshot} class="image-about" alt="headshot of Joey Bishop" />
			<p class="big">
				I'm a curious and motivated full-stack engineer with a passion for building accessible,
				performant web experiences.<br /><br />TypeScript and React are my bread and butter, but I
				like exploring different technologies.<br /><br />I have experience building DevOps
				workflows with GitHub Actions and Kubernetes.<br /><br />I earned my undergraduate degree in
				Computational Media and my Master’s in Computer Science.<br /><br />When I’m not
				coding, I’m writing, playing games, or hanging out with my wife and pets.
			</p>
		</div>
		<div class="col-item justify-items-start space-y-6">
			<Timeline
				title="Fullstack Engineer • Incident IQ"
				start="2025"
				chips={[
					'TypeScript',
					'React',
					'Angular',
					'C#',
					'.NET',
					'SQL',
					'GitOps',
					'Docker',
					'Kubernetes',
					'GitHub'
				]}
				link="https://www.incidentiq.com/"
			>
				<p class="body">
					Develop and maintain full stack solutions for K-12 school districts. Collaborate with
					cross-functional teams to design, implement, and deploy software solutions that meet
					customer needs. Support continuous integration and continuous delivery of software
					solutions.
				</p>
			</Timeline>
			<Timeline
				title="🎓 Georgia Institute of Technology"
				start="2024"
				end="2026"
				link="https://omscs.gatech.edu/"
			>
				<p class="body">Master's of Science in Computer Science<br />Spring 2026 | Interactive Intelligence</p>
			</Timeline>
			<Timeline
				title="Fullstack Engineer • NCR Voyix"
				start="2021"
				end="2025"
				chips={[
					'TypeScript',
					'React',
					'Redux',
					'Next.js',
					'Node.js',
					'GraphQL',
					'NestJS',
					'GCP',
					'Angular',
					'Java',
					'Spring Boot',
					'Hibernate',
					'PostgreSQL',
					'GitOps',
					'Docker',
					'Kubernetes',
					'GitHub'
				]}
				link="https://www.ncrvoyix.com/"
			>
				<p class="body">
					Developed and maintained full stack eCommerce solutions for restaurant and retail partners
					fitted with microservice backend and lightweight frontend UI. Tackled business problems at
					multiple stages of software development, from prototyping to product maintenance. Supported
					continuous integration and continuous delivery of software solutions.
				</p>
			</Timeline>
			<Timeline
				title="🎓 Georgia Institute of Technology"
				start="2017"
				end="2020"
				link="https://www.gatech.edu/"
			>
				<p class="body">
					Bachelor’s of Science in Computational Media<br />Fall 2020 | Highest Honors
				</p>
			</Timeline>
			<Timeline
				title="Frontend Engineer • Georgia Tech"
				start="Sep"
				end="Dec 2020"
				chips={['JavaScript', 'HTML/CSS', 'Web Dev']}
			>
				<p class="body">
					Maximized user engagement and accessibility by refactoring HTML, CSS, and JavaScript code.
					Developing webpage mockups with Affinity Designer to communicate ideas with team members.
				</p>
			</Timeline>
			<Timeline
				title="Software Tutor • Kids 4 Coding"
				start="Jun"
				end="Jul 2019"
				chips={['Python', 'Lua', 'Scratch', 'Robotics']}
				link="https://www.kids4coding.com/"
			>
				<p class="body">
					Taught children basic computer science concepts through computing experiences such as
					block-based coding, circuit board construction, and game development.
				</p>
			</Timeline>
		</div>
	</div>
</section>
